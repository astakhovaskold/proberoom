# Public HTTP port exposed by the Nginx reverse proxy.
HTTP_PORT=80

# PostgreSQL database provisioned by Docker Compose.
POSTGRES_DB=proberoom
POSTGRES_USER=proberoom
POSTGRES_PASSWORD=change-me-to-a-strong-database-password

# Backend runtime settings. Inside Docker Compose, DATABASE_URL is assembled
# automatically from the POSTGRES_* values above. Use this value when running
# the backend locally outside Docker.
PORT=3000
DATABASE_URL=postgresql://proberoom:change-me-to-a-strong-database-password@localhost:5432/proberoom?schema=public

# First-run admin account. The backend startup seed creates this user when it
# does not already exist; change these before deploying to a shared environment.
FIRST_RUN_ADMIN_EMAIL=admin@example.com
FIRST_RUN_ADMIN_PASSWORD=change-me-on-first-login
FIRST_RUN_ADMIN_NAME=Proberoom Admin

# Frontend build setting. The Docker image defaults to /api so browser requests
# flow through Nginx to the backend service.
VITE_API_URL=/api
